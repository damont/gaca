# Copy to .env and adjust. All vars are prefixed GACA_.

# Signing key for every token we mint. MUST be changed in production — anyone
# with this value can forge a token for any user. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GACA_JWT_SECRET=change-me
GACA_JWT_ALGORITHM=HS256
GACA_JWT_EXPIRE_MINUTES=10080

# Google OAuth. One Client ID for both sides — the API verifies the audience
# claim on incoming ID tokens, the frontend renders its button with the same
# value (frontend/.env, as VITE_GOOGLE_CLIENT_ID). Public, not a secret.
# Get one from https://console.cloud.google.com/apis/credentials
# Leave unset to disable Google sign-in; email/password still works.
GACA_GOOGLE_CLIENT_ID=

# Interface + port the server binds to. Loopback for local dev; use 0.0.0.0 on
# the Pi so the network can reach it.
GACA_API_HOST=127.0.0.1
GACA_API_PORT=41700

# Embedded SQLite file — the system of record. Defaults to ./gaca.db; set an
# absolute path in production (e.g. /var/lib/gaca/gaca.db).
GACA_DB_PATH=gaca.db

# Which engine adapter to load (must be set) + its HTTP gateway and bearer.
GACA_AGENT_ENGINE=hermes
GACA_AGENT_BASE_URL=http://127.0.0.1:8642
GACA_AGENT_API_KEY=

# Idle timeout (s) for the run event stream — no event for this long => failed.
GACA_AGENT_STREAM_IDLE_TIMEOUT=30
