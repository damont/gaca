# Copy to .env and adjust. All vars are prefixed GACA_.

# Signing key for every token we mint. MUST be changed in production — anyone
# with this value can forge a token for any user. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GACA_JWT_SECRET=change-me
GACA_JWT_ALGORITHM=HS256
GACA_JWT_EXPIRE_MINUTES=10080

# Google OAuth. One Client ID for both sides — the API verifies the audience
# claim on incoming ID tokens, the frontend renders its button with the same
# value (frontend/.env, as VITE_GOOGLE_CLIENT_ID). Public, not a secret.
# Get one from https://console.cloud.google.com/apis/credentials
# Leave unset to disable Google sign-in; email/password still works.
GACA_GOOGLE_CLIENT_ID=

# The iOS OAuth client id (Google Cloud console -> Credentials -> create an
# "iOS" client for the app's bundle id). Google Sign-In on iPhone mints ID
# tokens with THIS id as the audience, so the API accepts either id. Public,
# not a secret. Leave unset if there's no iOS app.
GACA_GOOGLE_IOS_CLIENT_ID=

# Interface + port the server binds to. Loopback for local dev; use 0.0.0.0 on
# the Pi so the network can reach it.
GACA_API_HOST=127.0.0.1
GACA_API_PORT=41700

# Embedded SQLite file — the system of record. Defaults to ./gaca.db; set an
# absolute path in production (e.g. /var/lib/gaca/gaca.db).
GACA_DB_PATH=gaca.db

# Which engine adapter to load — must be set. The gateway URL and bearer for
# it are NOT here: each user submits their own via PUT /api/auth/agent-config
# after signing in, so this app never has one shared agent target.
GACA_AGENT_ENGINE=hermes

# Idle timeout (s) for the run event stream — no event for this long => failed.
GACA_AGENT_STREAM_IDLE_TIMEOUT=180

# Path to a Firebase service-account JSON key (Firebase console -> Project
# settings -> Service accounts -> Generate new private key). A real secret,
# unlike GACA_GOOGLE_CLIENT_ID — never commit the file itself. Leave unset to
# disable push notifications entirely; the app's own polling still works.
GACA_FCM_CREDENTIALS_PATH=

# iPhone push goes straight to Apple (APNs), not through Firebase. Path to the
# .p8 auth key (Apple Developer -> Certificates, Identifiers & Profiles -> Keys,
# with Apple Push Notifications service enabled) — a real secret, never commit
# it. Key id is shown next to the key; team id is on the Membership page. All
# three must be set or iOS push is disabled; Android/FCM is unaffected.
GACA_APNS_KEY_PATH=
GACA_APNS_KEY_ID=
GACA_APNS_TEAM_ID=
# The iOS app's bundle id; APNs rejects tokens that belong to another app.
GACA_APNS_TOPIC=dev.monts.gaca
