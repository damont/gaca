# The GACA API as a sandboxed system service. Rendered and installed by `./install.sh`
# (placeholders in @…@ are filled in); you normally never touch this file by hand.
#
# Why a system unit and not `systemctl --user`: the filesystem sandbox below needs a mount
# namespace. A user manager can only build one with an unprivileged user namespace, which
# Ubuntu 24.04+ blocks by default (kernel.apparmor_restrict_unprivileged_userns=1). There the
# options are accepted and then silently NOT applied — the process could still read ~/.ssh.
# `sudo ./deploy/check-sandbox.sh` proves the sandbox really applies on your machine.
#
# What it can touch: read the code, read Hermes' home, write the GACA data directory and
# Hermes' profiles/ directory (so creating a crew member works). Everything else under your
# home directory is invisible to it. A leading '-' means "skip if the path doesn't exist".
[Unit]
Description=GACA API
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@/gaca-api
EnvironmentFile=@REPO@/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@REPO@/gaca-api/.venv/bin/gaca-api
Restart=on-failure
RestartSec=3

# --- Sandbox ---------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@REPO@ -@HERMES_HOME@ -@HOME@/.local -@CONFIG_DIR@/secrets
BindPaths=@DATA_DIR@ -@HERMES_HOME@/profiles
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
