# The installer (./install.sh) writes the real .env for you; this lists what it can contain.
# Everything here is optional except the database path, and the installer sets that too.

# Where phones reach this server (e.g. https://gaca.example.com). `gaca-api pair` puts it in the QR code.
GACA_PUBLIC_URL=

# Where the database lives.
GACA_DB_PATH=

# Hermes, when it runs on this same machine.
GACA_AGENT_ENGINE=hermes
GACA_AGENT_ACCESS=local
GACA_HERMES_HOME=
GACA_HERMES_BIN=

# Push notifications: path to a Firebase service-account JSON key. Unset = no push.
GACA_FCM_CREDENTIALS_PATH=
