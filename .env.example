VITE_GOOGLE_CLIENT_ID=


GACA_DATA_DIR=

# No GACA_AGENT_BASE_URL / GACA_AGENT_API_KEY here on purpose — there is no
# app-wide agent target. Each user submits their own via
# GACA_PUBLIC_URL (the address phones reach the server at) is what `gaca-api pair`
# puts in its QR code; the installer sets it.

# Directory holding the API's Unix socket; mounted into the frontend container
# (compose.production.yml). Must match the directory of GACA_API_SOCKET.
GACA_SOCKET_DIR=
